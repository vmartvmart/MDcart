<fieldset>
  <legend>{{ heading_title }}</legend>
  <div id="payment-methods" class="mb-2"></div>
  <input type="hidden" name="code" value="{{ code }}" id="input-payment-code"/>
  <div id="error-payment-method" class="alert alert-danger d-none"></div>
</fieldset>
<br/>
<div class="mb-2">
  <label for="input-comment" class="form-label"><strong>{{ text_comments }}</strong></label>
  <textarea name="comment" rows="4" id="input-comment" class="form-control">{{ comment }}</textarea>
</div>
{% if text_agree %}
  <div class="form-check form-switch form-switch-lg form-check-reverse mt-3">
    <label for="input-checkout-agree" class="form-check-label">{{ text_agree }}</label> <input type="checkbox" name="agree" value="1" id="input-checkout-agree" class="form-check-input"{% if agree %} checked{% endif %}/>
  </div>
{% endif %}
<script type="text/javascript"><!--
// The payment method step used to be a read-only text field + a "Choose"
// button that opened a modal with the actual list - the customer had to
// click twice before ever seeing which gateways were available. It's now
// shown as a plain inline list of the active gateways as soon as they can
// be determined, and selecting one immediately saves it - no extra button,
// no modal.
window.checkoutHasShipping = {{ has_shipping ? 'true' : 'false' }};

function paymentMethodsPlaceholder(text) {
    $('#payment-methods').html('<div class="text-muted">' + text + '</div>');
}

window.loadPaymentMethods = function() {
    chain.attach(function() {
        return $.ajax({
            url: 'index.php?route=checkout/payment_method.getMethods&language={{ language }}',
            dataType: 'json',
            beforeSend: function() {
                paymentMethodsPlaceholder('{{ text_loading|escape('js') }}');
            },
            success: function(json) {
                $('#error-payment-method').addClass('d-none').html('');

                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    $('#payment-methods').html('');
                    $('#error-payment-method').removeClass('d-none').html(json['error']);

                    return;
                }

                if (json['payment_methods']) {
                    // Generic per-category icons (not any gateway's own
                    // brand logo/mark - see the 5.6.43 changelog note for
                    // why) so the list isn't just a wall of same-size text;
                    // keyed by the extension's own code (the "i" this loop
                    // already iterates over). Anything not listed here
                    // falls back to a plain card icon.
                    var paymentMethodIcons = {
                        'bank_transfer': 'fa-solid fa-building-columns',
                        'cod': 'fa-solid fa-truck',
                        'cheque': 'fa-solid fa-money-check-dollar',
                        'free_checkout': 'fa-solid fa-circle-check',
                        'card_to_card': 'fa-solid fa-building-columns'
                    };

                    var html = '';
                    var first = true;
                    var method = $('#input-payment-code').val();

                    for (i in json['payment_methods']) {
                        if (!json['payment_methods'][i]['error']) {
                            var icon = paymentMethodIcons[i] || 'fa-solid fa-credit-card';

                            for (j in json['payment_methods'][i]['option']) {
                                var code = i + '-' + j.replaceAll('_', '-');
                                var checked = (json['payment_methods'][i]['option'][j]['code'] == method) || (!method && first);

                                if (checked) {
                                    first = false;
                                }

                                html += '<label for="input-payment-method-' + code + '" class="payment-method-option">';
                                html += '  <input type="radio" name="payment_method" value="' + json['payment_methods'][i]['option'][j]['code'] + '" id="input-payment-method-' + code + '" class="form-check-input flex-shrink-0"' + (checked ? ' checked' : '') + '/>';
                                html += '  <i class="' + icon + ' payment-method-icon"></i>';
                                html += '  <span class="payment-method-name">' + json['payment_methods'][i]['option'][j]['name'] + '</span>';
                                html += '</label>';
                            }
                        }
                    }

                    $('#payment-methods').html(html);

                    if ($('input[name=\'payment_method\']:checked').length) {
                        $('input[name=\'payment_method\']:checked').trigger('change');
                    }
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
};

// Selecting a gateway saves it immediately, matching how a radio list
// behaves everywhere else on this store - no separate "continue" click.
$(document).on('change', 'input[name=\'payment_method\']', function() {
    chain.attach(function() {
        return $.ajax({
            url: 'index.php?route=checkout/payment_method.save&language={{ language }}',
            type: 'post',
            data: 'payment_method=' + encodeURIComponent($('input[name=\'payment_method\']:checked').val()),
            dataType: 'json',
            contentType: 'application/x-www-form-urlencoded',
            success: function(json) {
                if (json['redirect']) {
                    location = json['redirect'];
                }

                if (json['error']) {
                    $('#error-payment-method').removeClass('d-none').html(json['error']);
                }

                if (json['success']) {
                    $('#error-payment-method').addClass('d-none').html('');

                    $('#input-payment-code').val($('input[name=\'payment_method\']:checked').val());

                    $('#checkout-confirm').load('index.php?route=checkout/confirm.confirm&language={{ language }}');
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});

if ({{ ready ? 'true' : 'false' }}) {
    loadPaymentMethods();
} else if (window.checkoutHasShipping) {
    paymentMethodsPlaceholder('{{ text_select_shipping_first|escape('js') }}');
} else {
    paymentMethodsPlaceholder('{{ text_complete_info_first|escape('js') }}');
}
//--></script>
