</main>
<footer>
  <div class="container">
    <div class="row">
      {% if informations or blog %}
        <div class="col-sm-3">
          <h5>{{ text_information }}</h5>
          <ul class="list-unstyled">
            {% if blog %}
              <li><a href="{{ blog }}">{{ text_blog }}</a></li>
            {% endif %}
            {% for information in informations %}
              <li><a href="{{ information.href }}">{{ information.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      <div class="col-sm-3">
        <h5>{{ text_service }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ contact }}">{{ text_contact }}</a></li>
          <li><a href="{{ return }}">{{ text_return }}</a></li>
          {% if gdpr %}
            <li><a href="{{ gdpr }}">{{ text_gdpr }}</a></li>
          {% endif %}
          <li><a href="{{ sitemap }}">{{ text_sitemap }}</a></li>
        </ul>
      </div>
      <div class="col-sm-3">
        <h5>{{ text_extra }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ manufacturer }}">{{ text_manufacturer }}</a></li>
          {% if affiliate %}
            <li><a href="{{ affiliate }}">{{ text_affiliate }}</a></li>
          {% endif %}
          <li><a href="{{ special }}">{{ text_special }}</a></li>
        </ul>
      </div>
      <div class="col-sm-3">
        <h5>{{ text_account }}</h5>
        <ul class="list-unstyled">
          <li><a href="{{ account }}">{{ text_account }}</a></li>
          <li><a href="{{ order }}">{{ text_order }}</a></li>
          <li><a href="{{ wishlist }}">{{ text_wishlist }}</a></li>
          <li><a href="{{ newsletter }}">{{ text_newsletter }}</a></li>
        </ul>
      </div>
    </div>
    {% if modules %}
      <hr>
      <div class="row justify-content-center text-center">
        {% for module in modules %}
          {{ module }}
        {% endfor %}
      </div>
    {% endif %}
    <hr>
    {% if trust_badges_html %}
      <style>
        /* Scoped rules for the admin-pasted trust/license badge codes
           (Settings > General > "نمادها و مجوزهای اعتماد"). Kept inline
           here (rather than in the main stylesheet) so it always matches
           the currently deployed template with no CSS-file cache lag.
           - Forces each badge's <a> to hug its own <img> instead of the
             theme's "footer a { display:block; width:100% }" list-link
             style, which was making the ENTIRE row clickable.
           - Gives every badge a consistent, larger height regardless of
             its original SVG/PNG size, and lets multiple badges wrap
             onto more than one line on narrow screens. */
        .footer-trust-badges a { display: inline-block !important; width: auto !important; height: auto !important; }
        .footer-trust-badges img { display: inline-block !important; height: 100px !important; width: auto !important; max-width: 200px; vertical-align: middle; }
      </style>
      <div class="footer-trust-badges d-flex flex-wrap justify-content-center align-items-center gap-3 mb-2">
        {{ trust_badges_html }}
      </div>
    {% endif %}
    <p>{{ powered }}</p>
  </div>
</footer>
</div>
{{ cookie }}
<script src="{{ bootstrap }}" type="text/javascript"></script>
{% for script in scripts %}
  <script src="{{ script.href }}" type="text/javascript"></script>
{% endfor %}
</body></html>
