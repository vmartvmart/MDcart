{{ header }}
<div id="account-login" class="container">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>
  {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> {{ success }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> {{ error_warning }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  <div class="row">
    {{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5 mb-3">
          <div class="border rounded p-4">
            <h1 class="h2 mb-3">{{ heading_title }}</h1>
            <form id="form-login" action="{{ login }}" method="post" data-oc-toggle="ajax">
              <div class="mb-3" id="group-identifier">
                <label for="input-identifier" class="col-form-label">{{ entry_identifier }}</label>
                <div class="input-group">
                  <input type="text" name="identifier" value="{{ identifier }}" placeholder="{{ entry_identifier }}" id="input-identifier" class="form-control" autofocus/>
                  <button type="button" class="btn btn-outline-secondary d-none" id="button-change">{{ button_edit }}</button>
                </div>
                <div id="error-identifier" class="invalid-feedback"></div>
              </div>
              <div class="mb-3 d-none" id="group-password">
                <label for="input-password" class="col-form-label">{{ entry_password }}</label>
                <input type="password" name="password" value="" placeholder="{{ entry_password }}" id="input-password" class="form-control mb-1"/>
                <a href="{{ forgotten }}">{{ text_forgotten }}</a>
                <div id="error-password" class="invalid-feedback"></div>
              </div>
              {% if redirect %}
                <input type="hidden" name="redirect" value="{{ redirect }}"/>
              {% endif %}
              <div class="text-end mb-2 d-none" id="group-login-otp">
                <a href="" id="link-login-otp">{{ text_login_otp }}</a>
              </div>
              <div class="text-end">
                <button type="button" id="button-check" class="btn btn-primary">{{ button_continue }}</button>
                <button type="submit" id="button-login" class="btn btn-primary d-none">{{ button_login }}</button>
              </div>
            </form>
            <hr/>
            <div class="text-center">
              <span>{{ text_new_customer }}</span> <a href="{{ register }}">{{ text_register }}</a>
            </div>
          </div>
        </div>
      </div>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
<script type="text/javascript"><!--
$(document).ready(function() {
    'use strict';

    $('#button-check').on('click', function() {
        var button = this;
        var identifier = $.trim($('#input-identifier').val());

        $('#alert .alert-dismissible').remove();
        $('#input-identifier').removeClass('is-invalid');
        $('#error-identifier').removeClass('d-block').html('');

        if (!identifier) {
            $('#input-identifier').addClass('is-invalid');
            $('#error-identifier').html('{{ error_identifier|e('js') }}').addClass('d-block');

            return;
        }

        $(button).button('loading');

        $.ajax({
            url: '{{ check }}',
            type: 'post',
            data: {identifier: identifier},
            dataType: 'json',
            complete: function() {
                $(button).button('reset');
            },
            success: function(json) {
                if (json['error']) {
                    $('#input-identifier').addClass('is-invalid');
                    $('#error-identifier').html(json['error']).addClass('d-block');

                    return;
                }

                if (json['state'] == 'new') {
                    location = json['register'];

                    return;
                }

                $('#input-identifier').prop('readonly', true);
                $('#group-password').removeClass('d-none');
                $('#button-check').addClass('d-none');
                $('#button-change').removeClass('d-none');
                $('#button-login').removeClass('d-none');
                $('#input-password').trigger('focus');

                if (json['otp']) {
                    $('#link-login-otp').attr('href', json['otp']);
                    $('#group-login-otp').removeClass('d-none');
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });

    $('#input-identifier').on('keydown', function(e) {
        if ((e.which == 13) && $('#button-check').is(':visible')) {
            e.preventDefault();

            $('#button-check').trigger('click');
        }
    });

    $('#button-change').on('click', function() {
        // Let the visitor go back and check a different identifier.
        $('#input-identifier').prop('readonly', false).trigger('focus');
        $('#input-password').val('');
        $('#group-password').addClass('d-none');
        $('#group-login-otp').addClass('d-none');
        $('#button-login').addClass('d-none');
        $('#button-change').addClass('d-none');
        $('#button-check').removeClass('d-none');
    });
});
//--></script>
{{ footer }}
