+              <label for="input-telephone" class="col-form-label">{{ entry_telephone }}</label>
+              <input type="text" name="telephone" value="" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" inputmode="tel" dir="ltr"/>
+              <div id="error-telephone" class="invalid-feedback"></div>
+            </div>
+            {% if redirect %}
+              <input type="hidden" name="redirect" value="{{ redirect }}"/>
+            {% endif %}
+            <div class="row">
+              <div class="col">
+                <a href="{{ login }}" class="btn btn-light">{{ button_back }}</a>
+              </div>
+              <div class="col text-end">
+                <button type="submit" class="btn btn-primary">{{ button_continue }}</button>
+              </div>
+            </div>
+          </form>
+        </div>
+      </div>
+      {{ content_bottom }}</div>
+    {{ column_right }}</div>
+</div>
+{{ footer }}
