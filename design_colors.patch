+<script type="text/javascript"><!--
+// Every field pairs a "use a custom color" switch with a disabled-by-default
+// <input type="color">. jQuery's form serialize() (used by the generic
+// data-oc-toggle="ajax" submit handler in common.js) skips disabled inputs
+// entirely, so unchecking a switch and saving is what actually clears that
+// setting back to "let the theme decide" server-side.
+$('.color-switch').on('change', function() {
+    var input = $($(this).data('target'));
+
+    input.prop('disabled', !$(this).is(':checked'));
+});
+//--></script>
