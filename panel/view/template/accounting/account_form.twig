{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="float-end">
				<button type="submit" form="form-account" formaction="{{ save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
				<a href="{{ back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		<div id="alert-placeholder"></div>
		<div class="card">
			<div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_form }}</div>
			<div class="card-body">
				<form id="form-account">
					<input type="hidden" id="input-account-id" value="{{ account_id }}"/>
					{% if is_system %}
						<div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_system }} - {{ text_bank_cash }}</div>
					{% endif %}
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label">{{ entry_parent }}</label>
						<div class="col-sm-9">
							<select id="input-parent" class="form-select"{% if is_system %} disabled{% endif %}>
								<option value="0"></option>
								{% for account in accounts %}
									{% if account.account_id != account_id %}
										<option value="{{ account.account_id }}"{% if parent_id == account.account_id %} selected{% endif %}>{{ account.code }} - {{ account.name }}</option>
									{% endif %}
								{% endfor %}
							</select>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label">{{ entry_code }}</label>
						<div class="col-sm-9">
							<input type="text" id="input-code" value="{{ code }}" class="form-control"{% if is_system %} disabled{% endif %}/>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label">{{ entry_name }}</label>
						<div class="col-sm-9">
							<input type="text" id="input-name" value="{{ name }}" class="form-control"/>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label">{{ entry_type }}</label>
						<div class="col-sm-9">
							<select id="input-type" class="form-select"{% if is_system %} disabled{% endif %}>
								{% for t in types %}
									<option value="{{ t }}"{% if type == t %} selected{% endif %}>{{ attribute(_context, 'text_type_' ~ t) }}</option>
								{% endfor %}
							</select>
						</div>
					</div>
					<div class="row mb-3">
						<label class="col-sm-3 col-form-label">{{ entry_status }}</label>
						<div class="col-sm-9">
							<label class="form-check form-switch form-switch-lg">
								<input type="checkbox" id="input-status" value="1" class="form-check-input"{% if status %} checked{% endif %}/>
							</label>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>
<script type="text/javascript"><!--
$('#form-account').on('submit', function(e) {
    e.preventDefault();

    $.ajax({
        url: '{{ save }}',
        type: 'post',
        data: {
            account_id: $('#input-account-id').val(),
            parent_id: $('#input-parent').val(),
            code: $('#input-code').val(),
            name: $('#input-name').val(),
            type: $('#input-type').val(),
            status: $('#input-status').is(':checked') ? 1 : 0
        },
        dataType: 'json',
        success: function(json) {
            $('#alert-placeholder').html('');

            if (json.error) {
                var message = json.error.warning || json.error.name || json.error.code || '';

                $('#alert-placeholder').html('<div class="alert alert-danger">' + message + '</div>');
                return;
            }

            $('#alert-placeholder').html('<div class="alert alert-success">' + json.success + '</div>');

            if (json.account_id) {
                $('#input-account-id').val(json.account_id);
            }
        }
    });
});
//--></script>
{{ footer }}
