{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<h1>{{ heading_title }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		<div class="card">
			<div class="card-header"><i class="fa-solid fa-filter"></i> {{ button_filter }}</div>
			<div class="card-body">
				<div class="row g-2 align-items-end">
					<div class="col-md-3">
						<label class="form-label">{{ entry_date_start }}</label>
						<input type="date" id="input-date-start" value="{{ filter_date_start }}" class="form-control"/>
					</div>
					<div class="col-md-3">
						<label class="form-label">{{ entry_date_end }}</label>
						<input type="date" id="input-date-end" value="{{ filter_date_end }}" class="form-control"/>
					</div>
					<div class="col-md-4">
						<label class="form-label">{{ entry_warehouse }}</label>
						<select id="input-warehouse" class="form-select">
							<option value="">{{ text_all_warehouses }}</option>
							{% for warehouse in warehouses %}
								<option value="{{ warehouse.warehouse_id }}"{% if filter_warehouse_id == warehouse.warehouse_id %} selected{% endif %}>{{ warehouse.name }}</option>
							{% endfor %}
						</select>
					</div>
					<div class="col-md-2">
						<button type="button" id="button-filter" class="btn btn-primary w-100"><i class="fa-solid fa-magnifying-glass"></i> {{ button_filter }}</button>
					</div>
				</div>
			</div>
		</div>
		<div id="profit-loss" class="mt-3">{{ list }}</div>
	</div>
</div>
<script type="text/javascript"><!--
function reloadProfitLoss() {
    var url = '{{ list_action }}';

    url += '&filter_date_start=' + encodeURIComponent($('#input-date-start').val());
    url += '&filter_date_end=' + encodeURIComponent($('#input-date-end').val());

    var warehouseId = $('#input-warehouse').val();

    if (warehouseId) {
        url += '&filter_warehouse_id=' + encodeURIComponent(warehouseId);
    }

    $.ajax({
        url: url,
        dataType: 'html',
        success: function(html) {
            $('#profit-loss').html(html);
        }
    });
}

$('#button-filter').on('click', function() {
    reloadProfitLoss();
});

$('#profit-loss').on('click', '.pagination a', function(e) {
    e.preventDefault();

    $.ajax({
        url: this.href,
        dataType: 'html',
        success: function(html) {
            $('#profit-loss').html(html);
        }
    });
});
//--></script>
{{ footer }}
