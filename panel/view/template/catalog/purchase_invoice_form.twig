{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="float-end">
				{% if not readonly %}<button type="submit" form="form-purchase-invoice" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>{% endif %}
				<a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		{% if readonly %}
			<div class="alert alert-info"><i class="fa-solid fa-circle-info"></i> {{ text_readonly_help }}</div>
		{% endif %}
		<div class="card">
			<div class="card-header"><i class="fa-solid fa-file-invoice"></i> {{ text_form }}</div>
			<div class="card-body">
				<div id="alert-placeholder"></div>
				<form id="form-purchase-invoice" action="{{ save }}" method="post" data-oc-toggle="ajax">
					<div class="row mb-3 required">
						<label for="input-warehouse" class="col-sm-2 col-form-label">{{ entry_warehouse }}</label>
						<div class="col-sm-4">
							<select name="warehouse_id" id="input-warehouse" class="form-select"{% if readonly %} disabled{% endif %}>
								<option value=""></option>
								{% for warehouse in warehouses %}
									<option value="{{ warehouse.warehouse_id }}"{% if warehouse.warehouse_id == warehouse_id %} selected{% endif %}>{{ warehouse.name }} ({{ warehouse.currency_code }})</option>
								{% endfor %}
							</select>
						</div>
						<label for="input-invoice-date" class="col-sm-2 col-form-label">{{ entry_invoice_date }}</label>
						<div class="col-sm-4">
							<input type="date" name="invoice_date" value="{{ invoice_date }}" id="input-invoice-date" class="form-control"{% if readonly %} readonly{% endif %}/>
						</div>
					</div>
					<div class="row mb-3">
						<label for="input-supplier" class="col-sm-2 col-form-label">{{ entry_supplier }}</label>
						<div class="col-sm-4">
							<select name="supplier_id" id="input-supplier" class="form-select"{% if readonly %} disabled{% endif %}>
								<option value="">{{ text_supplier_none }}</option>
								{% for supplier in suppliers %}
									<option value="{{ supplier.supplier_id }}" data-name="{{ supplier.name }}"{% if supplier.supplier_id == supplier_id %} selected{% endif %}>{{ supplier.name }} ({{ supplier.currency_code }})</option>
								{% endfor %}
							</select>
							{% if readonly and not supplier_id and supplier_name %}<div class="form-text">{{ supplier_name }}</div>{% endif %}
							<input type="text" name="supplier_name" id="input-supplier-name" value="{{ supplier_name }}" class="form-control d-none"/>
						</div>
						<label for="input-invoice-number" class="col-sm-2 col-form-label">{{ entry_invoice_number }}</label>
						<div class="col-sm-4">
							<input type="text" name="invoice_number" value="{{ invoice_number }}" id="input-invoice-number" class="form-control"{% if readonly %} readonly{% endif %}/>
						</div>
					</div>
					<div class="row mb-3 required">
						<label for="input-payment-type" class="col-sm-2 col-form-label">{{ entry_payment_type }}</label>
						<div class="col-sm-4">
							<select name="payment_type" id="input-payment-type" class="form-select"{% if readonly %} disabled{% endif %}>
								<option value="cash"{% if payment_type == 'cash' %} selected{% endif %}>{{ text_payment_cash }}</option>
								<option value="bank"{% if payment_type == 'bank' %} selected{% endif %}>{{ text_payment_bank }}</option>
								<option value="credit"{% if payment_type == 'credit' %} selected{% endif %}>{{ text_payment_credit }}</option>
								<option value="combined"{% if payment_type == 'combined' %} selected{% endif %}>{{ text_payment_combined }}</option>
							</select>
						</div>
						<label for="input-bank-account" class="col-sm-2 col-form-label" id="label-bank-account">{{ entry_bank_account }}</label>
						<div class="col-sm-4" id="group-bank-account">
							<select name="bank_account_id" id="input-bank-account" class="form-select"{% if readonly %} disabled{% endif %}>
								<option value=""></option>
								{% for bank_account in bank_accounts %}
									<option value="{{ bank_account.bank_account_id }}"{% if bank_account.bank_account_id == bank_account_id %} selected{% endif %}>{{ bank_account.name }}</option>
								{% endfor %}
							</select>
						</div>
					</div>
					<div class="row mb-3" id="group-paid-amount">
						<label for="input-paid-amount" class="col-sm-2 col-form-label">{{ entry_paid_amount }}</label>
						<div class="col-sm-4">
							<div class="input-group">
								<input type="text" name="paid_amount" value="{{ paid_amount }}" id="input-paid-amount" class="form-control text-end"{% if readonly %} readonly{% endif %}/>
								<span class="input-group-text">{{ currency_code }}</span>
							</div>
						</div>
					</div>
					<div class="row mb-3">
						<label for="input-comment" class="col-sm-2 col-form-label">{{ entry_comment }}</label>
						<div class="col-sm-10">
							<textarea name="comment" id="input-comment" rows="2" class="form-control"{% if readonly %} readonly{% endif %}>{{ comment }}</textarea>
						</div>
					</div>

					{% if not readonly %}
						<fieldset>
							<legend>{{ text_add_product }}</legend>
							<div class="row mb-3">
								<div class="col-sm-5">
									<input type="text" id="input-product" placeholder="{{ entry_product }}" class="form-control" autocomplete="off"/>
									<ul id="autocomplete-product" class="dropdown-menu"></ul>
								</div>
								<div class="col-sm-3">
									<input type="text" id="input-barcode" placeholder="{{ entry_barcode }}" class="form-control"/>
									<small class="form-text text-muted">{{ help_barcode }}</small>
								</div>
								<div class="col-sm-2">
									<input type="number" id="input-product-quantity" value="1" min="1" class="form-control" placeholder="{{ column_quantity }}"/>
								</div>
								<div class="col-sm-2">
									<button type="button" id="button-add-product" class="btn btn-primary w-100">{{ button_add_product }}</button>
								</div>
							</div>
						</fieldset>
					{% endif %}

					<div class="table-responsive">
						<table class="table table-bordered" id="table-product">
							<thead>
								<tr>
									<th>{{ column_product }}</th>
									<th class="text-end col-2">{{ column_quantity }}</th>
									<th class="text-end col-2">{{ column_unit_cost }}</th>
									{% if not readonly %}<th class="text-end col-1"></th>{% endif %}
								</tr>
							</thead>
							<tbody>
								{% for product in products %}
									<tr>
										<td>{{ product.name }}<input type="hidden" name="products[{{ loop.index0 }}][product_id]" value="{{ product.product_id }}"/><input type="hidden" name="products[{{ loop.index0 }}][barcode]" value="{{ product.barcode }}"/></td>
										<td class="text-end"><input type="text" name="products[{{ loop.index0 }}][quantity]" value="{{ product.quantity }}" class="form-control text-end"{% if readonly %} readonly{% endif %}/></td>
										<td class="text-end"><input type="text" name="products[{{ loop.index0 }}][unit_cost]" value="{{ product.unit_cost }}" class="form-control text-end"{% if readonly %} readonly{% endif %}/></td>
										{% if not readonly %}<td class="text-end"><button type="button" class="btn btn-danger button-remove-product"><i class="fa-regular fa-trash-can"></i></button></td>{% endif %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
					<input type="hidden" name="purchase_invoice_id" value="{{ purchase_invoice_id }}"/>
				</form>

				{% if readonly %}
					<hr/>
					<div class="row">
						<div class="col-sm-4">
							<strong>{{ text_total_amount }}:</strong> {{ total_amount }} {{ currency_code }}
						</div>
						<div class="col-sm-4">
							<strong>{{ text_paid_amount }}:</strong> {{ paid_amount }} {{ currency_code }}
						</div>
						<div class="col-sm-4">
							<strong>{{ text_outstanding }}:</strong> {{ outstanding_formatted }}
						</div>
					</div>

					{% if payments %}
						<hr/>
						<h5>{{ text_payment_history }}</h5>
						<table class="table table-bordered table-sm">
							<thead>
								<tr>
									<th>{{ column_date_added }}</th>
									<th>{{ entry_bank_account }}</th>
									<th class="text-end">{{ column_amount }}</th>
								</tr>
							</thead>
							<tbody>
								{% for payment in payments %}
									<tr>
										<td>{{ payment.date_added }}</td>
										<td>{{ payment.bank_account_name }}</td>
										<td class="text-end">{{ payment.amount }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					{% endif %}

					{% if can_pay %}
						<hr/>
						<h5>{{ text_record_payment }}</h5>
						<div id="pay-alert-placeholder"></div>
						<form id="form-purchase-invoice-payment">
							<div class="row mb-3">
								<div class="col-sm-4">
									<select id="input-pay-bank-account" class="form-select">
										<option value=""></option>
										{% for bank_account in bank_accounts %}
											<option value="{{ bank_account.bank_account_id }}">{{ bank_account.name }}</option>
										{% endfor %}
									</select>
								</div>
								<div class="col-sm-4">
									<div class="input-group">
										<input type="text" id="input-pay-amount" placeholder="{{ entry_amount }}" class="form-control text-end"/>
										<span class="input-group-text">{{ currency_code }}</span>
									</div>
								</div>
								<div class="col-sm-4">
									<button type="submit" class="btn btn-primary">{{ button_record_payment }}</button>
								</div>
							</div>
						</form>
					{% endif %}
				{% endif %}
			</div>
		</div>
	</div>
</div>
<script type="text/javascript"><!--
var productRowIndex = {{ products|length }};

function addProductRow(productId, productName, quantity, unitCost, barcode) {
    if (!productId || !quantity) {
        return;
    }

    var html = '<tr>';
    html += '<td>' + productName + '<input type="hidden" name="products[' + productRowIndex + '][product_id]" value="' + productId + '"/><input type="hidden" name="products[' + productRowIndex + '][barcode]" value="' + (barcode || '') + '"/></td>';
    html += '<td class="text-end"><input type="text" name="products[' + productRowIndex + '][quantity]" value="' + quantity + '" class="form-control text-end"/></td>';
    html += '<td class="text-end"><input type="text" name="products[' + productRowIndex + '][unit_cost]" value="' + (unitCost || 0) + '" class="form-control text-end"/></td>';
    html += '<td class="text-end"><button type="button" class="btn btn-danger button-remove-product"><i class="fa-regular fa-trash-can"></i></button></td>';
    html += '</tr>';

    $('#table-product tbody').append(html);

    productRowIndex++;
}

function togglePaymentFields() {
    var type = $('#input-payment-type').val();

    if (type === 'credit') {
        $('#group-bank-account, #label-bank-account').hide();
    } else {
        $('#group-bank-account, #label-bank-account').show();
    }

    if (type === 'combined') {
        $('#group-paid-amount').show();
    } else {
        $('#group-paid-amount').hide();
    }
}

togglePaymentFields();

{% if not readonly %}
$('#input-payment-type').on('change', togglePaymentFields);

$('#input-product').autocomplete({
    'source': function(request, response) {
        $.ajax({
            url: '{{ autocomplete }}&filter_name=' + encodeURIComponent(request),
            dataType: 'json',
            success: function(json) {
                response($.map(json, function(item) {
                    return {
                        label: item['name'],
                        value: item['product_id'],
                        price: item['price']
                    }
                }));
            }
        });
    },
    'select': function(item) {
        $('#input-product').val(decodeHTMLEntities(item['label'])).attr('data-product-id', item['value']).attr('data-price', item['price']);
    }
});

$('#button-add-product').on('click', function() {
    var productId = $('#input-product').attr('data-product-id');
    var productName = $('#input-product').val();
    var quantity = $('#input-product-quantity').val();

    addProductRow(productId, productName, quantity, 0, '');

    $('#input-product').val('').removeAttr('data-product-id');
    $('#input-product-quantity').val(1);
});

// Keyboard-wedge barcode scanner support: a USB/Bluetooth scanner just types
// the code very fast and sends Enter - so pressing Enter in this field looks
// up the code (against the product's model/EAN/UPC/etc.) and adds it straight
// to the table, no click needed.
$('#input-barcode').on('keydown', function(e) {
    if (e.which !== 13) {
        return;
    }

    e.preventDefault();

    var code = $(this).val().trim();

    if (!code) {
        return;
    }

    var quantity = $('#input-product-quantity').val() || 1;
    var field = $(this);

    $.ajax({
        url: '{{ autocomplete }}&filter_model=' + encodeURIComponent(code),
        dataType: 'json',
        success: function(json) {
            if (json.length) {
                addProductRow(json[0]['product_id'], json[0]['name'], quantity, 0, code);
            } else {
                alert('{{ text_barcode_not_found|escape('js') }}' + ' (' + code + ')');
            }

            field.val('').focus();
        }
    });
});

$('#table-product').on('click', '.button-remove-product', function() {
    $(this).closest('tr').remove();
});
{% endif %}

{% if can_pay %}
$('#form-purchase-invoice-payment').on('submit', function(e) {
    e.preventDefault();

    $.ajax({
        url: '{{ pay }}',
        type: 'post',
        data: {
            purchase_invoice_id: {{ purchase_invoice_id }},
            bank_account_id: $('#input-pay-bank-account').val(),
            amount: $('#input-pay-amount').val()
        },
        dataType: 'json',
        success: function(json) {
            $('#pay-alert-placeholder').html('');

            if (json.error) {
                $('#pay-alert-placeholder').html('<div class="alert alert-danger">' + (json.error.warning || '') + '</div>');
                return;
            }

            $('#pay-alert-placeholder').html('<div class="alert alert-success">' + json.success + '</div>');

            location.reload();
        }
    });
});
{% endif %}
//--></script>
{{ footer }}
