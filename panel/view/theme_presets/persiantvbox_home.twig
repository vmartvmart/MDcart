{{ header }}
<div class="theme-persiantvbox-hero">
  <div class="theme-persiantvbox-glow"></div>
  <div class="theme-persiantvbox-bar theme-persiantvbox-bar-top"></div>
  <div class="theme-persiantvbox-content">
    <h1>{{ name }}</h1>
    <p>{{ text_hero_tagline }}</p>
    <a href="index.php?route=product/category" class="btn btn-primary me-2">{{ button_hero_products }}</a>
    <a href="index.php?route=product/special" class="btn btn-outline-light">{{ button_hero_special }}</a>
  </div>
  <div class="theme-persiantvbox-bar theme-persiantvbox-bar-bottom"></div>
</div>
{% if home_products %}
  <div class="theme-persiantvbox-row">
    <div class="container">
      <h2>{{ text_new_products_heading }}</h2>
      <div class="theme-persiantvbox-poster-track">
        {% for product in home_products %}
          <a href="{{ product.href }}" class="theme-persiantvbox-poster" style="background-image:url('{{ product.thumb }}');">
            <span class="theme-persiantvbox-poster-overlay">
              <span class="theme-persiantvbox-poster-title">{{ product.name }}</span>
              {% if product.price %}<span class="theme-persiantvbox-poster-price">{{ product.price }}</span>{% endif %}
            </span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}
<div id="common-home" class="container">
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}{{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
