+        var button = this;
+        var identifier = $.trim($('#input-identifier').val());
+
+        $('#alert .alert-dismissible').remove();
+        $('#input-identifier').removeClass('is-invalid');
+        $('#error-identifier').removeClass('d-block').html('');
+
+        if (!identifier) {
+            $('#input-identifier').addClass('is-invalid');
+            $('#error-identifier').html('{{ error_identifier|e('js') }}').addClass('d-block');
+
+            return;
+        }
+
+        $(button).button('loading');
+
+        $.ajax({
+            url: '{{ check }}',
+            type: 'post',
+            data: {identifier: identifier},
+            dataType: 'json',
+            complete: function() {
+                $(button).button('reset');
+            },
+            success: function(json) {
+                if (json['error']) {
+                    $('#input-identifier').addClass('is-invalid');
+                    $('#error-identifier').html(json['error']).addClass('d-block');
+
+                    return;
+                }
+
+                if (json['state'] == 'new') {
+                    location = json['register'];
+
+                    return;
+                }
+
+                $('#input-identifier').prop('readonly', true);
+                $('#group-password').removeClass('d-none');
+                $('#button-check').addClass('d-none');
+                $('#button-change').removeClass('d-none');
+                $('#button-login').removeClass('d-none');
+                $('#input-password').trigger('focus');
+
+                if (json['otp']) {
+                    $('#link-login-otp').attr('href', json['otp']);
+                    $('#group-login-otp').removeClass('d-none');
+                }
+            },
+            error: function(xhr, ajaxOptions, thrownError) {
+                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
+            }
+        });
+    });
+
+    $('#input-identifier').on('keydown', function(e) {
+        if ((e.which == 13) && $('#button-check').is(':visible')) {
+            e.preventDefault();
+
+            $('#button-check').trigger('click');
+        }
+    });
+
+    $('#button-change').on('click', function() {
+        // Let the visitor go back and check a different identifier.
+        $('#input-identifier').prop('readonly', false).trigger('focus');
+        $('#input-password').val('');
+        $('#group-password').addClass('d-none');
+        $('#group-login-otp').addClass('d-none');
+        $('#button-login').addClass('d-none');
+        $('#button-change').addClass('d-none');
+        $('#button-check').removeClass('d-none');
+    });
+});
+//--></script>
 {{ footer }}
