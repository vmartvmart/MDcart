<form id="form-warehouse" method="post" data-oc-toggle="ajax" data-oc-load="{{ action }}" data-oc-target="#warehouse">
  <div class="table-responsive">
    <table class="table table-bordered table-hover">
      <thead>
        <tr>
          <th class="text-center" style="width: 1px;"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', $(this).prop('checked'));" class="form-check-input"/></th>
          <th>{{ column_name }}</th>
          <th class="text-center">{{ column_currency }}</th>
          <th class="text-center">{{ column_selling_warehouse }}</th>
          <th class="text-center">{{ column_status }}</th>
          <th class="text-end col-1">{{ column_action }}</th>
        </tr>
      </thead>
      <tbody>
        {% if warehouses %}
          {% for warehouse in warehouses %}
            <tr>
              <td class="text-center"><input type="checkbox" name="selected[]" value="{{ warehouse.warehouse_id }}" class="form-check-input"/></td>
              <td>{{ warehouse.name }}</td>
              <td class="text-center">{{ warehouse.currency_code }}</td>
              <td class="text-center">{% if warehouse.is_selling_warehouse %}<span class="badge text-bg-success">{{ text_yes }}</span>{% else %}<span class="text-muted">-</span>{% endif %}</td>
              <td class="text-center">{% if warehouse.status %}<span class="badge text-bg-success">{{ text_enabled }}</span>{% else %}<span class="badge text-bg-danger">{{ text_disabled }}</span>{% endif %}</td>
              <td class="text-end"><a href="{{ warehouse.edit }}" data-bs-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa-solid fa-pencil"></i></a></td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td class="text-center" colspan="6">{{ text_no_results }}</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</form>
