<div class="table-responsive">
  <table class="table table-bordered table-hover">
    <thead>
      <tr>
        <th>{{ column_invoice_number }}</th>
        <th>{{ column_supplier }}</th>
        <th>{{ column_warehouse }}</th>
        <th class="text-center">{{ column_invoice_date }}</th>
        <th>{{ column_date_added }}</th>
        <th class="text-end col-1">{{ column_action }}</th>
      </tr>
    </thead>
    <tbody>
      {% if purchase_invoices %}
        {% for purchase_invoice in purchase_invoices %}
          <tr>
            <td>{{ purchase_invoice.invoice_number ?: '-' }}</td>
            <td>{{ purchase_invoice.supplier_name ?: '-' }}</td>
            <td>{{ purchase_invoice.warehouse_name }}</td>
            <td class="text-center">{{ purchase_invoice.invoice_date ?: '-' }}</td>
            <td>{{ purchase_invoice.date_added }}</td>
            <td class="text-end"><a href="{{ purchase_invoice.view }}" data-bs-toggle="tooltip" title="{{ button_view }}" class="btn btn-primary"><i class="fa-solid fa-eye"></i></a></td>
          </tr>
        {% endfor %}
      {% else %}
        <tr>
          <td class="text-center" colspan="6">{{ text_no_results }}</td>
        </tr>
      {% endif %}
    </tbody>
  </table>
</div>
