{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<div class="float-end">
				{% if status == 'posted' %}
					<button type="button" id="button-void" class="btn btn-danger"><i class="fa-solid fa-rotate-left"></i> {{ button_void }}</button>
				{% endif %}
				<a href="{{ back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
			</div>
			<h1>{{ heading_title }} #{{ journal_number }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		<div id="alert-placeholder"></div>
		<div class="card">
			<div class="card-body">
				<dl class="row mb-0">
					<dt class="col-sm-2">{{ column_type }}</dt>
					<dd class="col-sm-4">{{ reference_type }}</dd>
					<dt class="col-sm-2">{{ column_status }}</dt>
					<dd class="col-sm-4">{{ status_text }}</dd>
					<dt class="col-sm-2">{{ column_date }}</dt>
					<dd class="col-sm-4">{{ date_added }}</dd>
					<dt class="col-sm-2">{{ column_description }}</dt>
					<dd class="col-sm-10">{{ description }}</dd>
				</dl>
			</div>
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-bordered mb-0">
						<thead>
							<tr>
								<th>{{ column_account }}</th>
								<th class="text-end">{{ column_debit }}</th>
								<th class="text-end">{{ column_credit }}</th>
								<th>{{ column_description }}</th>
							</tr>
						</thead>
						<tbody>
							{% for line in lines %}
								<tr>
									<td>{{ line.account_code }} - {{ line.account_name }}</td>
									<td class="text-end">{{ line.debit }}</td>
									<td class="text-end">{{ line.credit }}</td>
									<td>{{ line.description }}</td>
								</tr>
							{% endfor %}
						</tbody>
						<tfoot>
							<tr class="fw-bold">
								<td></td>
								<td class="text-end">{{ total_debit }} {{ currency_symbol }}</td>
								<td class="text-end">{{ total_credit }} {{ currency_symbol }}</td>
								<td></td>
							</tr>
						</tfoot>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<script type="text/javascript"><!--
$('#button-void').on('click', function() {
    if (!confirm('{{ text_confirm_void|escape('js') }}')) {
        return;
    }

    $.ajax({
        url: '{{ void }}',
        type: 'post',
        data: {journal_id: {{ journal_id }}},
        dataType: 'json',
        success: function(json) {
            if (json.error) {
                $('#alert-placeholder').html('<div class="alert alert-danger">' + json.error + '</div>');
                return;
            }

            location.reload();
        }
    });
});
//--></script>
{{ footer }}
