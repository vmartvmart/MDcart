<form id="form-account">
	<div class="table-responsive">
		<table class="table table-bordered">
			<thead>
				<tr>
					<td style="width:1px;"></td>
					<th>{{ column_code }}</th>
					<th>{{ column_name }}</th>
					<th>{{ column_type }}</th>
					<th class="text-end">{{ column_balance }}</th>
					<th class="text-center">{{ column_status }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for account in accounts %}
					<tr>
						<td class="text-center"><input type="checkbox" name="selected[]" value="{{ account.account_id }}"/></td>
						<td>{{ account.code }}</td>
						<td style="padding-left: {{ 12 + account.depth * 24 }}px;">
							{{ account.name }}
							{% if account.is_system %}<span class="badge text-bg-secondary">{{ text_system }}</span>{% endif %}
							{% if account.is_bank_cash %}<span class="badge text-bg-info">{{ text_bank_cash }}</span>{% endif %}
						</td>
						<td>{{ account.type }}</td>
						<td class="text-end">{{ account.balance }}</td>
						<td class="text-center">{% if account.status %}<span class="badge text-bg-success">&#10003;</span>{% else %}<span class="badge text-bg-danger">&#10005;</span>{% endif %}</td>
						<td class="text-end"><a href="{{ account.edit }}" data-bs-toggle="tooltip" title="{{ button_edit|default('Edit') }}" class="btn btn-primary btn-sm"><i class="fa-solid fa-pencil"></i></a></td>
					</tr>
				{% else %}
					<tr>
						<td class="text-center text-muted" colspan="7">{{ text_list }}: 0</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</form>
