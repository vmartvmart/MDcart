{{ header }}{{ column_left }}
<div id="content">
	<div class="page-header">
		<div class="container-fluid">
			<h1>{{ heading_title_trial_balance }}</h1>
			<ol class="breadcrumb">
				{% for breadcrumb in breadcrumbs %}
					<li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
				{% endfor %}
			</ol>
		</div>
	</div>
	<div class="container-fluid">
		<div class="card mb-3">
			<div class="card-body">
				<div class="row g-2 align-items-end">
					<div class="col-md-4">
						<label class="form-label">{{ entry_date_start }}</label>
						<input type="date" id="input-date-start" value="{{ filter_date_start }}" class="form-control"/>
					</div>
					<div class="col-md-4">
						<label class="form-label">{{ entry_date_end }}</label>
						<input type="date" id="input-date-end" value="{{ filter_date_end }}" class="form-control"/>
					</div>
					<div class="col-md-4">
						<button type="button" id="button-filter" class="btn btn-primary w-100"><i class="fa-solid fa-magnifying-glass"></i> {{ button_filter }}</button>
					</div>
				</div>
			</div>
		</div>
		{% if not balanced %}
			<div class="alert alert-danger"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_unbalanced }}</div>
		{% else %}
			<div class="alert alert-success"><i class="fa-solid fa-check"></i> {{ text_balanced }}</div>
		{% endif %}
		<div class="card">
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-bordered mb-0">
						<thead>
							<tr>
								<th>{{ column_code }}</th>
								<th>{{ column_name }}</th>
								<th>{{ column_account_type }}</th>
								<th class="text-end">{{ column_debit }}</th>
								<th class="text-end">{{ column_credit }}</th>
								<th class="text-end">{{ column_balance }}</th>
							</tr>
						</thead>
						<tbody>
							{% for row in rows %}
								<tr>
									<td>{{ row.code }}</td>
									<td>{{ row.name }}</td>
									<td>{{ row.type }}</td>
									<td class="text-end">{{ row.debit }}</td>
									<td class="text-end">{{ row.credit }}</td>
									<td class="text-end">{{ row.balance }}</td>
								</tr>
							{% else %}
								<tr>
									<td class="text-center text-muted" colspan="6">0</td>
								</tr>
							{% endfor %}
						</tbody>
						<tfoot>
							<tr class="fw-bold">
								<td colspan="3"></td>
								<td class="text-end">{{ total_debit }}</td>
								<td class="text-end">{{ total_credit }}</td>
								<td></td>
							</tr>
						</tfoot>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>
<script type="text/javascript"><!--
$('#button-filter').on('click', function() {
    var url = '{{ filter_action }}';

    url += '&filter_date_start=' + encodeURIComponent($('#input-date-start').val());
    url += '&filter_date_end=' + encodeURIComponent($('#input-date-end').val());

    location = url;
});
//--></script>
{{ footer }}
