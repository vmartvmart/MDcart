<form id="form-bank-account">
	<div class="table-responsive">
		<table class="table table-bordered">
			<thead>
				<tr>
					<td style="width:1px;"></td>
					<th>{{ column_name }}</th>
					<th>{{ column_bank_name }}</th>
					<th>{{ column_role }}</th>
					<th class="text-end">{{ column_balance }}</th>
					<th class="text-center">{{ column_status }}</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				{% for bank_account in bank_accounts %}
					<tr>
						<td class="text-center"><input type="checkbox" name="selected[]" value="{{ bank_account.bank_account_id }}"/></td>
						<td>{{ bank_account.name }}</td>
						<td>{{ bank_account.bank_name }} {{ bank_account.account_number }}</td>
						<td>{% if bank_account.default_role_text %}<span class="badge text-bg-info">{{ bank_account.default_role_text }}</span>{% endif %}</td>
						<td class="text-end">{{ bank_account.balance }} {{ currency_symbol }}</td>
						<td class="text-center">{% if bank_account.status %}<span class="badge text-bg-success">&#10003;</span>{% else %}<span class="badge text-bg-danger">&#10005;</span>{% endif %}</td>
						<td class="text-end"><a href="{{ bank_account.edit }}" class="btn btn-primary btn-sm"><i class="fa-solid fa-pencil"></i></a></td>
					</tr>
				{% else %}
					<tr>
						<td class="text-center text-muted" colspan="7">{{ text_list }}: 0</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</form>
