@@ -0,0 +1,119 @@
+{{ header }}{{ column_left }}
+<div id="content">
+  <div class="page-header">
+    <div class="container-fluid">
+      <div class="float-end">
+        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
+        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
+      <h1>{{ heading_title }}</h1>
+      <ol class="breadcrumb">
+        {% for breadcrumb in breadcrumbs %}
+          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
+        {% endfor %}
+      </ol>
+    </div>
+  </div>
+  <div class="container-fluid">
+    <div class="card">
+      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
+      <div class="card-body">
+        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
+          <div class="row mb-3 required">
+            <label for="input-client-id" class="col-sm-2 col-form-label">{{ entry_client_id }}</label>
+            <div class="col-sm-10">
+              <input type="text" name="payment_digipay_client_id" value="{{ payment_digipay_client_id }}" id="input-client-id" class="form-control"/>
+              <div id="error-client-id" class="invalid-feedback"></div>
+            </div>
+          </div>
+          <div class="row mb-3 required">
+            <label for="input-client-secret" class="col-sm-2 col-form-label">{{ entry_client_secret }}</label>
+            <div class="col-sm-10">
+              <input type="text" name="payment_digipay_client_secret" value="{{ payment_digipay_client_secret }}" id="input-client-secret" class="form-control"/>
+              <div id="error-client-secret" class="invalid-feedback"></div>
+            </div>
+          </div>
+          <div class="row mb-3 required">
+            <label for="input-username" class="col-sm-2 col-form-label">{{ entry_username }}</label>
+            <div class="col-sm-10">
+              <input type="text" name="payment_digipay_username" value="{{ payment_digipay_username }}" id="input-username" class="form-control" autocomplete="off"/>
+              <div id="error-username" class="invalid-feedback"></div>
+            </div>
+          </div>
+          <div class="row mb-3 required">
+            <label for="input-password" class="col-sm-2 col-form-label">{{ entry_password }}</label>
+            <div class="col-sm-10">
+              <input type="password" name="payment_digipay_password" value="{{ payment_digipay_password }}" id="input-password" class="form-control" autocomplete="new-password"/>
+              <div id="error-password" class="invalid-feedback"></div>
+            </div>
+          </div>
+          <div class="row mb-3">
+            <label class="col-sm-2 col-form-label">{{ entry_sandbox }}</label>
+            <div class="col-sm-10">
+              <div class="form-check form-switch form-switch-lg">
+                <input type="hidden" name="payment_digipay_sandbox" value="0"/>
+                <input type="checkbox" name="payment_digipay_sandbox" value="1" id="input-sandbox" class="form-check-input"{% if payment_digipay_sandbox %} checked{% endif %}/>
+              </div>
+              <div class="form-text">{{ help_sandbox }}</div>
+            </div>
+          </div>
+          <div class="row mb-3">
+            <label class="col-sm-2 col-form-label">{{ text_callback_url }}</label>
+            <div class="col-sm-10">
+              <input type="text" value="{{ callback_url }}" class="form-control" readonly="readonly"/>
+              <div class="form-text">{{ help_callback_url }}</div>
+            </div>
+          </div>
+          <div class="row mb-3">
+            <label for="input-order-status" class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
+            <div class="col-sm-10">
+              <select name="payment_digipay_order_status_id" id="input-order-status" class="form-select">
+                {% for order_status in order_statuses %}
+                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_digipay_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
+                {% endfor %}
+              </select>
+            </div>
+          </div>
+          <div class="row mb-3">
+            <label for="input-deliver-order-status" class="col-sm-2 col-form-label">{{ entry_deliver_order_status }}</label>
+            <div class="col-sm-10">
+              <select name="payment_digipay_deliver_order_status_id" id="input-deliver-order-status" class="form-select">
+                <option value="0">{{ text_none }}</option>
+                {% for order_status in order_statuses %}
+                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_digipay_deliver_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
+                {% endfor %}
+              </select>
+              <div class="form-text">{{ help_deliver_order_status }}</div>
+            </div>
+          </div>
+          <div class="row mb-3">
+            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
+            <div class="col-sm-10">
+              <select name="payment_digipay_geo_zone_id" id="input-geo-zone" class="form-select">
+                <option value="0">{{ text_all_zones }}</option>
+                {% for geo_zone in geo_zones %}
+                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_digipay_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
+                {% endfor %}
+              </select>
+            </div>
+          </div>
+          <div class="row mb-3">
+            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
+            <div class="col-sm-10">
+              <div class="form-check form-switch form-switch-lg">
+                <input type="hidden" name="payment_digipay_status" value="0"/>
+                <input type="checkbox" name="payment_digipay_status" value="1" id="input-status" class="form-check-input"{% if payment_digipay_status %} checked{% endif %}/>
+              </div>
+            </div>
+          </div>
+          <div class="row mb-3">
+            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
+            <div class="col-sm-10">
+              <input type="text" name="payment_digipay_sort_order" value="{{ payment_digipay_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
+            </div>
+          </div>
+        </form>
+      </div>
+    </div>
+  </div>
+</div>
+{{ footer }}
