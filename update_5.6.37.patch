@@ -1709,5 +1716,35 @@ $(document).on('click', '#button-trust-badge-add', function() {
 $(document).on('click', '[data-oc-toggle=\'remove-trust-badge\']', function() {
     $(this).closest('tr').remove();
 });
+
+// Drag-to-reorder trust badge rows (plain HTML5 drag-and-drop - no
+// library needed). Only the grip handle itself is draggable="true" (not
+// the whole row), so dragging text inside the name/HTML fields still
+// works as normal text selection. Saving the form submits the inputs in
+// their current DOM order, and that same order is what the storefront
+// footer loops over - so no extra "sort order" field is needed, moving
+// the rows here is the entire feature.
+var trustBadgeDragged = null;
+
+$(document).on('dragstart', '#table-trust-badge .drag-handle', function() {
+    trustBadgeDragged = $(this).closest('tr').get(0);
+});
+
+$(document).on('dragover', '#table-trust-badge tbody tr', function(e) {
+    if (!trustBadgeDragged || trustBadgeDragged === this) {
+        return;
+    }
+
+    e.preventDefault();
+
+    var rect = this.getBoundingClientRect();
+    var before = (e.originalEvent.clientY - rect.top) < (rect.height / 2);
+
+    $(this)[before ? 'before' : 'after'](trustBadgeDragged);
+});
+
+$(document).on('dragend', '#table-trust-badge .drag-handle', function() {
+    trustBadgeDragged = null;
+});
 //--></script>
