{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-ippanel" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-ippanel" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_ippanel_status" value="0"/>
                  <input type="checkbox" name="other_ippanel_status" value="1" id="input-status" class="form-check-input"{% if other_ippanel_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3 required">
              <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
              <div class="col-sm-10">
                <input type="text" name="other_ippanel_api_key" value="{{ other_ippanel_api_key }}" id="input-api-key" class="form-control" dir="ltr"/>
                <div id="error-api-key" class="invalid-feedback"></div>
                <div class="form-text">{{ help_api_key }}</div>
              </div>
            </div>
            <div class="row mb-3 required">
              <label for="input-sender" class="col-sm-2 col-form-label">{{ entry_sender }}</label>
              <div class="col-sm-10">
                <input type="text" name="other_ippanel_sender" value="{{ other_ippanel_sender }}" id="input-sender" class="form-control" dir="ltr"/>
                <div id="error-sender" class="invalid-feedback"></div>
                <div class="form-text">{{ help_sender }}</div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_notifications }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_order_add_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_ippanel_order_add_status" value="0"/>
                  <input type="checkbox" name="other_ippanel_order_add_status" value="1" id="input-order-add-status" class="form-check-input"{% if other_ippanel_order_add_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_order_status_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_ippanel_order_status_status" value="0"/>
                  <input type="checkbox" name="other_ippanel_order_status_status" value="1" id="input-order-status-status" class="form-check-input"{% if other_ippanel_order_status_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_admin_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_ippanel_admin_status" value="0"/>
                  <input type="checkbox" name="other_ippanel_admin_status" value="1" id="input-admin-status" class="form-check-input"{% if other_ippanel_admin_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-admin-telephone" class="col-sm-2 col-form-label">{{ entry_admin_telephone }}</label>
              <div class="col-sm-10">
                <input type="text" name="other_ippanel_admin_telephone" value="{{ other_ippanel_admin_telephone }}" id="input-admin-telephone" class="form-control" dir="ltr"/>
                <div class="form-text">{{ help_admin_telephone }}</div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_otp }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_otp_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_ippanel_otp_status" value="0"/>
                  <input type="checkbox" name="other_ippanel_otp_status" value="1" id="input-otp-status" class="form-check-input"{% if other_ippanel_otp_status %} checked{% endif %}/>
                </div>
                <div id="error-otp-status" class="invalid-feedback"></div>
                <div class="form-text">{{ help_otp_status }}</div>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
