{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-auto-translate" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-auto-translate" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_auto_translate_status" value="0"/>
                  <input type="checkbox" name="other_auto_translate_status" value="1" id="input-status" class="form-check-input"{% if other_auto_translate_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
              <div class="col-sm-10">
                {% if other_auto_translate_api_key_set %}
                  <div class="form-text">{{ text_key_set }} <code dir="ltr">{{ other_auto_translate_api_key_masked }}</code></div>
                {% else %}
                  <div class="form-text">{{ text_key_not_set }}</div>
                {% endif %}
                <input type="password" autocomplete="new-password" name="other_auto_translate_api_key" value="" id="input-api-key" class="form-control" dir="ltr"/>
                <div id="error-api-key" class="invalid-feedback"></div>
                <div class="form-text">{{ help_api_key }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-model" class="col-sm-2 col-form-label">{{ entry_model }}</label>
              <div class="col-sm-10">
                <input type="text" name="other_auto_translate_model" value="{{ other_auto_translate_model }}" placeholder="claude-haiku-4-5-20251001" id="input-model" class="form-control" dir="ltr"/>
                <div class="form-text">{{ help_model }}</div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_scope }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_products_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_auto_translate_products_status" value="0"/>
                  <input type="checkbox" name="other_auto_translate_products_status" value="1" id="input-products-status" class="form-check-input"{% if other_auto_translate_products_status %} checked{% endif %}/>
                </div>
                <div class="form-text">{{ help_products_status }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_categories_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_auto_translate_categories_status" value="0"/>
                  <input type="checkbox" name="other_auto_translate_categories_status" value="1" id="input-categories-status" class="form-check-input"{% if other_auto_translate_categories_status %} checked{% endif %}/>
                </div>
                <div class="form-text">{{ help_categories_status }}</div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend><i class="fa-solid fa-shield-halved"></i> {{ text_security }}</legend>
            <div class="row mb-3">
              <div class="col-sm-12">
                <div class="alert alert-info mb-0">{{ help_security }}</div>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
