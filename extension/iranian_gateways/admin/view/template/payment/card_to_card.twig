{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <fieldset>
            <legend>{{ text_add_card }}</legend>
            <table id="table-card" class="table table-bordered">
              <thead>
                <tr>
                  <td style="width: 1px;">{{ text_active }}</td>
                  <td>{{ entry_card_number }}</td>
                  <td>{{ entry_holder_name }}</td>
                  <td>{{ entry_bank_name }}</td>
                  <td style="width: 1px;"></td>
                </tr>
              </thead>
              <tbody>
                {% for uid, card in payment_card_to_card_cards %}
                  <tr>
                    <td class="text-center">
                      <input type="radio" name="payment_card_to_card_active" value="{{ uid }}" class="form-check-input"{% if uid == payment_card_to_card_active %} checked{% endif %}/>
                    </td>
                    <td>
                      <input type="text" name="payment_card_to_card_cards[{{ uid }}][card_number]" value="{{ card.card_number }}" maxlength="19" placeholder="6219861012345678" class="form-control"/>
                      <div id="error-card-number-{{ uid }}" class="invalid-feedback"></div>
                    </td>
                    <td>
                      <input type="text" name="payment_card_to_card_cards[{{ uid }}][holder_name]" value="{{ card.holder_name }}" class="form-control"/>
                      <div id="error-holder-name-{{ uid }}" class="invalid-feedback"></div>
                    </td>
                    <td>
                      <input type="text" name="payment_card_to_card_cards[{{ uid }}][bank_name]" value="{{ card.bank_name }}" class="form-control"/>
                    </td>
                    <td class="text-center">
                      <button type="button" data-oc-toggle="remove-card" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
            <button type="button" id="button-card-add" class="btn btn-primary"><i class="fa-solid fa-plus-circle"></i> {{ text_add_card }}</button>
          </fieldset>
          {% for language in languages %}
            <div class="row mb-3">
              <label for="input-instruction{{ language.language_id }}" class="col-sm-2 col-form-label">{{ entry_instruction }}</label>
              <div class="col-sm-10">
                <div class="input-group">
                  <span class="input-group-text"><img src="{{ language.image }}" title="{{ language.name }}"/></span> <textarea name="payment_card_to_card_instruction_{{ language.language_id }}" cols="80" rows="5" placeholder="{{ entry_instruction }}" id="input-instruction-{{ language.language_id }}" class="form-control">{{ payment_card_to_card_instruction[language.language_id] }}</textarea>
                </div>
                <div class="form-text">{{ help_instruction }}</div>
              </div>
            </div>
          {% endfor %}
          <div class="row mb-3">
            <label for="input-order-status" class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_card_to_card_order_status_id" id="input-order-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_card_to_card_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ help_order_status }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
            <div class="col-sm-10">
              <select name="payment_card_to_card_geo_zone_id" id="input-geo-zone" class="form-select">
                <option value="0">{{ text_all_zones }}</option>
                {% for geo_zone in geo_zones %}
                  <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_card_to_card_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_card_to_card_status" value="0"/>
                <input type="checkbox" name="payment_card_to_card_status" value="1" id="input-status" class="form-check-input"{% if payment_card_to_card_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_card_to_card_sort_order" value="{{ payment_card_to_card_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<template id="template-card-row">
  <tr>
    <td class="text-center">
      <input type="radio" name="payment_card_to_card_active" value="" class="form-check-input"/>
    </td>
    <td>
      <input type="text" name="" maxlength="19" placeholder="6219861012345678" class="form-control" data-oc-field="card_number"/>
    </td>
    <td>
      <input type="text" name="" class="form-control" data-oc-field="holder_name"/>
    </td>
    <td>
      <input type="text" name="" class="form-control" data-oc-field="bank_name"/>
    </td>
    <td class="text-center">
      <button type="button" data-oc-toggle="remove-card" class="btn btn-danger"><i class="fa-solid fa-minus-circle"></i></button>
    </td>
  </tr>
</template>
<script type="text/javascript"><!--
$(document).on('click', '#button-card-add', function() {
    var uid = 'card_' + Date.now().toString(36) + Math.floor(Math.random() * 1000).toString(36);
    var template = document.getElementById('template-card-row');
    var row = template.content.cloneNode(true);

    $(row).find('input[type=\'radio\']').attr('value', uid);

    $(row).find('input[data-oc-field]').each(function() {
        var field = $(this).attr('data-oc-field');
        $(this).attr('name', 'payment_card_to_card_cards[' + uid + '][' + field + ']');
    });

    $('#table-card tbody').append(row);
});

$(document).on('click', '[data-oc-toggle=\'remove-card\']', function() {
    $(this).closest('tr').remove();
});
//--></script>
{{ footer }}
