<fieldset>
  <legend>{{ text_instruction }}</legend>
  <p><b>{{ text_description }}</b></p>
  <div class="border rounded p-3 mb-2">
    <p class="fs-4 fw-bold text-center">{{ card_number }}</p>
    <p class="text-center">{{ text_holder }}: {{ holder_name }}{% if bank_name %} &mdash; {{ text_bank }}: {{ bank_name }}{% endif %}</p>
    {% if instruction %}
      <p>{{ instruction|raw }}</p>
    {% endif %}
    <p>{{ text_payment }}</p>
  </div>
  <div class="mb-3">
    <label for="input-card-to-card-note" class="form-label">{{ entry_note }}</label>
    <input type="text" id="input-card-to-card-note" class="form-control"/>
  </div>
  <div class="text-end">
    <button type="button" id="button-confirm" class="btn btn-primary">{{ button_confirm }}</button>
  </div>
</fieldset>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function() {
    var element = this;

    $.ajax({
        url: 'index.php?route=extension/iranian_gateways/payment/card_to_card.confirm&language={{ language }}',
        type: 'post',
        data: {
            note: $('#input-card-to-card-note').val()
        },
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['redirect']) {
                location = json['redirect'];
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
