{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-bale" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-comment-dots"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-bale" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <input type="hidden" name="other_bale_admin_chat_id" value="{{ other_bale_admin_chat_id }}"/>
          <input type="hidden" name="other_bale_admin_link_token" value="{{ other_bale_admin_link_token }}"/>
          <fieldset>
            <legend>{{ text_general }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_bale_status" value="0"/>
                  <input type="checkbox" name="other_bale_status" value="1" id="input-status" class="form-check-input"{% if other_bale_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3 required">
              <label for="input-bot-token" class="col-sm-2 col-form-label">{{ entry_bot_token }}</label>
              <div class="col-sm-10">
                <input type="text" name="other_bale_bot_token" value="{{ other_bale_bot_token }}" id="input-bot-token" class="form-control" dir="ltr"/>
                <div id="error-bot-token" class="invalid-feedback"></div>
                <div class="form-text">{{ help_bot_token }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-bot-username" class="col-sm-2 col-form-label">{{ entry_bot_username }}</label>
              <div class="col-sm-10">
                <input type="text" name="other_bale_bot_username" value="{{ other_bale_bot_username }}" id="input-bot-username" class="form-control" dir="ltr"/>
                <div class="form-text">{{ help_bot_username }}</div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_webhook }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ text_webhook_url }}</label>
              <div class="col-sm-10">
                <input type="text" value="{{ webhook_url }}" class="form-control" dir="ltr" readonly="readonly"/>
                <div class="form-text">{{ help_webhook }}</div>
                <button type="button" id="button-set-webhook" data-url="{{ set_webhook }}" class="btn btn-secondary mt-2">{{ button_set_webhook }}</button>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_admin_connect }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
              <div class="col-sm-10">
                {% if other_bale_admin_chat_id %}
                  <span class="badge text-bg-success">{{ text_connected }}</span>
                {% else %}
                  <span class="badge text-bg-secondary">{{ text_not_connected }}</span>
                  {% if admin_connect_link %}
                    <div class="form-text"><a href="{{ admin_connect_link }}" target="_blank" dir="ltr">{{ admin_connect_link }}</a><br/>{{ text_connect_button }}</div>
                  {% endif %}
                {% endif %}
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_notifications }}</legend>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_order_add_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_bale_order_add_status" value="0"/>
                  <input type="checkbox" name="other_bale_order_add_status" value="1" id="input-order-add-status" class="form-check-input"{% if other_bale_order_add_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_order_status_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_bale_order_status_status" value="0"/>
                  <input type="checkbox" name="other_bale_order_status_status" value="1" id="input-order-status-status" class="form-check-input"{% if other_bale_order_status_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label class="col-sm-2 col-form-label">{{ entry_admin_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="other_bale_admin_status" value="0"/>
                  <input type="checkbox" name="other_bale_admin_status" value="1" id="input-admin-status" class="form-check-input"{% if other_bale_admin_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-set-webhook').on('click', function() {
    var button = this;

    $.ajax({
        url: $(button).attr('data-url'),
        dataType: 'json',
        success: function(json) {
            if (json['error']) {
                alert(json['error']);
            }

            if (json['success']) {
                alert(json['success']);
            }
        }
    });
});
//--></script>
{{ footer }}
