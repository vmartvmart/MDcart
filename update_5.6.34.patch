+                <input type="hidden" name="total_payment_fee_status" value="0"/>
+                <input type="checkbox" name="total_payment_fee_status" value="1" id="input-status" class="form-check-input"{% if total_payment_fee_status %} checked{% endif %}/>
+              </div>
+            </div>
+          </div>
+          <div class="row mb-3">
+            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
+            <div class="col-sm-10">
+              <input type="text" name="total_payment_fee_sort_order" value="{{ total_payment_fee_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
+            </div>
+          </div>
+        </form>
+      </div>
+    </div>
+  </div>
+</div>
+{{ footer }}
